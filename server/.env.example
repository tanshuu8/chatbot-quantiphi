# Server
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ai-chat-assistant

# AI Provider (OpenAI or any OpenAI-compatible API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini    # or any OpenAI-compatible model (e.g. qwen/qwen3-8b for Groq)
# Optional: set a custom base URL to use Groq, Ollama, or other OpenAI-compatible providers:
# OPENAI_BASE_URL=https://api.openai.com/v1
